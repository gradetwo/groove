{
  "name": "groove-music-genre-learning",
  "private": true,
  "version": "2.0.92",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --quiet",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "lint:data": "vitest run src/test/schema.test.ts src/test/schemaFields.test.ts src/test/genreContentAudit.test.ts src/test/genreHarmony.test.ts src/test/genreIndexDrift.test.ts src/test/genreIdReferences.test.ts src/test/genreLinks.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "E2E_PROFILE=pc node scripts/test_matrix.js",
    "check:budget": "node scripts/check_budgets.js",
    "redlines": "node scripts/redlines.mjs",
    "docs:check": "node scripts/check_docs.mjs",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "fast": "node scripts/track.mjs fast",
    "fast:build": "node scripts/track.mjs fast --with-build",
    "slow": "node scripts/track.mjs slow",
    "slow:pack": "node scripts/slow_pack.mjs run",
    "handoff": "node scripts/slow_pack.mjs run",
    "handoff:e2e": "node scripts/slow_pack.mjs run --only e2e --label e2e",
    "slow:export": "node scripts/slow_pack.mjs export",
    "slow:verify": "node scripts/slow_pack.mjs verify",
    "verify": "npm run version:check && npm run docs:check && npm run redlines && npm run check:layers && npm run check:css && npm run check:docs:refs && npm run typecheck && npm run lint && npm run lint:data && npm run test && npm run build && npm run probe:toolbar && npm run probe:grid-gutter && npm run check:budget && npm run check:gs1 && npm run test:e2e",
    "package": "npm run verify && python3 scripts/package.py",
    "deploy": "npm run verify && npm run deploy:only",
    "deploy:only": "node scripts/deploy.mjs",
    "perf:check": "node scripts/measure_live_perf.mjs --local",
    "probe:latency": "node scripts/measure_interaction_latency.mjs",
    "data:lint": "vite-node scripts/lint_genres.ts",
    "data:index": "vite-node scripts/build_genre_index.ts",
    "check:gs1": "node scripts/check-gs1.mjs",
    "check:layers": "node scripts/check_layers.mjs",
    "test:e2e:all": "E2E_PROFILE=all node scripts/test_matrix.js",
    "test:e2e:mobile": "E2E_PROFILE=mobile node scripts/test_matrix.js",
    "probe:scroll": "node scripts/serve_probe.mjs",
    "check:css": "vite-node scripts/check_css_usage.mjs",
    "check:docs:refs": "vite-node scripts/check_doc_refs.mjs",
    "probe:toolbar": "node scripts/measure_toolbar_density.mjs",
    "probe:grid-gutter": "node scripts/probe_grid_gutter.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.131.0"
  },
  "description": "Browser-based groove workstation and music-genre library: 159 genres, an 8-track step sequencer, a piano roll, Web Audio synthesis, and WAV/MIDI/Ableton export.",
  "license": "MIT",
  "keywords": [
    "music",
    "sequencer",
    "web-audio",
    "step-sequencer",
    "piano-roll",
    "drum-machine",
    "music-theory",
    "genres"
  ]
}
