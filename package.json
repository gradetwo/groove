{
  "name": "groove-music-genre-learning",
  "private": true,
  "version": "2.34.44",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "lint:data": "vitest run src/test/schema.test.ts src/test/schemaFields.test.ts src/test/genreContentAudit.test.ts src/test/genreHarmony.test.ts src/test/genreIndexDrift.test.ts src/test/genreIdReferences.test.ts src/test/genreLinks.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "E2E_PROFILE=pc node scripts/test_matrix.js",
    "check:budget": "node scripts/check_budgets.js",
    "redlines": "node scripts/redlines.mjs",
    "docs:check": "node scripts/check_docs.mjs",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "fast": "node scripts/track.mjs fast",
    "fast:build": "node scripts/track.mjs fast --with-build",
    "slow": "node scripts/track.mjs slow",
    "slow:pack": "node scripts/slow_pack.mjs run",
    "handoff": "node scripts/slow_pack.mjs run",
    "handoff:e2e": "node scripts/slow_pack.mjs run --only e2e --label e2e",
    "slow:export": "node scripts/slow_pack.mjs export",
    "slow:verify": "node scripts/slow_pack.mjs verify",
    "verify": "npm run check:node && npm run check:actions && npm run check:disabled-gates && npm run version:check && npm run docs:check && npm run redlines && npm run check:layers && npm run check:isolation && npm run check:css && npm run check:skins && npm run check:skin-roles && npm run check:docs:refs && npm run typecheck && npm run lint && npm run lint:data && npm run test && npm run build && npm run probe:boot && npm run probe:toolbar && npm run probe:grid-gutter && npm run probe:arrangement && npm run probe:live-arrangement && npm run check:budget && npm run check:covers && npm run check:gs1 && npm run check:mcp:build && npm run check:mcp && npm run check:layout && npm run check:loudness && npm run check:loudness:fresh && npm run check:timbre && npm run test:e2e && npm run probe:continuity && npm run probe:skins && npm run probe:score-ink",
    "package": "npm run verify && python3 scripts/package.py",
    "deploy": "npm run verify && npm run deploy:only",
    "deploy:only": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "perf:check": "node scripts/measure_live_perf.mjs --local",
    "probe:latency": "node scripts/measure_interaction_latency.mjs",
    "data:lint": "vite-node scripts/lint_genres.ts",
    "data:index": "vite-node scripts/build_genre_index.ts",
    "check:gs1": "node scripts/check-gs1.mjs",
    "check:layers": "node scripts/check_layers.mjs",
    "test:e2e:all": "E2E_PROFILE=all node scripts/test_matrix.js",
    "probe:scroll": "node scripts/serve_probe.mjs",
    "check:css": "vite-node scripts/check_css_usage.mjs",
    "check:docs:refs": "vite-node scripts/check_doc_refs.mjs",
    "probe:toolbar": "node scripts/measure_toolbar_density.mjs",
    "probe:grid-gutter": "node scripts/probe_grid_gutter.mjs",
    "probe:arrangement": "node scripts/probe_arrangement.mjs",
    "probe:arrangement-audio": "node scripts/probe_arrangement_audio.mjs",
    "probe:arrangement-undo": "node scripts/probe_arrangement_undo.mjs",
    "probe:headless": "vite-node scripts/probe_headless_parity.ts",
    "cache:stats": "vite-node scripts/sample_cache.mjs --stats",
    "cache:clear": "vite-node scripts/sample_cache.mjs --clear",
    "probe:headless-silence": "vite-node scripts/probe_headless_silence.ts",
    "layout:sync": "vite-node scripts/layout_tokens.mjs",
    "check:layout": "vite-node scripts/layout_tokens.mjs --check",
    "check:loudness": "node scripts/disabled_gate_guard.mjs check:loudness -- node scripts/check_loudness_spread.mjs",
    "check:timbre": "node scripts/disabled_gate_guard.mjs check:timbre -- node scripts/check_timbre_spread.mjs",
    "check:node": "node scripts/check_node_version.mjs",
    "check:isolation": "node scripts/check_isolation.mjs",
    "check:loudness:fresh": "node scripts/disabled_gate_guard.mjs check:loudness:fresh -- node scripts/measure_genre_loudness.mjs --sample=3",
    "record:loudness": "node scripts/run_loudness_sweep.mjs",
    "check:actions": "node scripts/check_actions_runtime.mjs",
    "check:disabled-gates": "node scripts/check_disabled_gates.mjs",
    "skins:gen": "node scripts/desktop_skins.mjs",
    "check:skins": "node scripts/desktop_skins.mjs --check",
    "probe:skins": "node scripts/measure_skin_readability.mjs",
    "probe:skins:full": "node scripts/measure_skin_readability.mjs --full --report",
    "probe:score-ink": "node scripts/measure_score_ink.mjs",
    "mcp:build": "node scripts/build_mcp.mjs",
    "mcp": "node scripts/build_mcp.mjs && node dist-mcp/groove-mcp.mjs",
    "check:mcp": "node scripts/build_mcp.mjs && node scripts/check_mcp.mjs",
    "check:groove": "node scripts/disabled_gate_guard.mjs check:groove -- node scripts/check_groove.mjs",
    "check:skin-roles": "node scripts/check_skin_roles.mjs",
    "probe:live-arrangement": "node scripts/probe_live_arrangement.mjs",
    "check:covers": "node scripts/check_covers_payload.mjs",
    "probe:boot": "node scripts/probe_boot.mjs",
    "probe:continuity": "node scripts/probe_note_event_continuity.mjs",
    "check:mcp:build": "node scripts/check_mcp_build.mjs",
    "verify:code": "npm run check:node && npm run check:actions && npm run check:disabled-gates && npm run version:check && npm run docs:check && npm run redlines && npm run check:layers && npm run check:isolation && npm run check:css && npm run check:skins && npm run check:skin-roles && npm run check:docs:refs && npm run typecheck && npm run lint && npm run lint:data && npm run test && npm run build && npm run probe:boot && npm run probe:toolbar && npm run probe:grid-gutter && npm run probe:arrangement && npm run probe:live-arrangement && npm run check:budget && npm run check:covers && npm run check:gs1 && npm run check:mcp:build && npm run check:mcp && npm run check:layout && npm run check:loudness && npm run check:loudness:fresh && npm run check:timbre && npm run test:e2e && npm run probe:continuity && npm run probe:skins",
    "ci:status": "bash scripts/watch_ci.sh",
    "ci:watch": "bash scripts/watch_ci.sh --watch",
    "push:dev": "bash scripts/push_dev.sh",
    "ci:full": "bash scripts/ci_full.sh",
    "push:branch": "bash scripts/push_branch.sh"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.185.1",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.147.0"
  },
  "description": "Browser-based groove workstation and music-genre library: 159 genres, an 8-track step sequencer, a piano roll, Web Audio synthesis, and WAV/MIDI/Ableton export.",
  "license": "MIT",
  "keywords": [
    "music",
    "sequencer",
    "web-audio",
    "step-sequencer",
    "piano-roll",
    "drum-machine",
    "music-theory",
    "genres"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
