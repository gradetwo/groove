# Cloudflare Workers static assets HTTP Headers (P4-11)

# 1. Hashed production assets -> 1 year immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 2. Service Worker -> Never cache, always revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 3. Web App Manifest
/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

# 3b. Version check + changelog archive (A-08)
# The update check must never be stale: a 5-minute max-age meant "check for updates"
# reported the previous version for up to 5 minutes after a deploy (observed during
# the v1.16.7 release). It is a 3KB file, so revalidation is cheap.
/version.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/changelog.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8

# 4. Main HTML document -> Must revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
