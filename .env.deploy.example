# Cloudflare deploy credentials. Copy to `.env.deploy` (git-ignored) and fill in.
# Used by `npm run deploy:only` / `node scripts/deploy.mjs`.
#
# Create a token at: Cloudflare Dashboard → My Profile → API Tokens
# Required permission: Account → Workers Scripts → Edit  (plus Workers KV/Assets if used)

CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_ACCOUNT_ID=replace-me
