# Cloudflare Workers configuration for `npm run deploy` (scripts/deploy.mjs).
#
# The real `wrangler.toml` is git-ignored: it names *your* worker. Copy this file and set the
# name — every account gets a different one (the deployed demo uses its own).

name = "your-worker-name"
compatibility_date = "2024-09-23"
workers_dev = true

[assets]
directory = "./dist"
not_found_handling = "single-page-application"
