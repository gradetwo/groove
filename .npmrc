# Fail the install on a Node the toolchain cannot run on, instead of producing a broken
# node_modules. This is what turned "Node 20 in CI" into 190 unhandled
# `webidl.util.markAsUncloneable is not a function` errors from jsdom's nested undici,
# with no tests executed and 0% coverage (see `engines` in package.json).
engine-strict=true
